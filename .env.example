# Postgres connection (Neon in Vercel, local Postgres in development)
DATABASE_URL=postgres://viewing:viewing@localhost:5432/viewing
# Random 32+ character string: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app, e.g. http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Optional until the agent phases
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
ANTHROPIC_API_KEY=
# Channels, all optional; see docs/setup-channels.md and docs/setup-calendars.md
APP_URL=
CALENDAR_TOKEN_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_WEBHOOK_SIGNING_KEY=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_NUMBER=
